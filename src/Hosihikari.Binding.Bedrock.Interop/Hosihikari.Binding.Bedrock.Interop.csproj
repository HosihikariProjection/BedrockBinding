<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <RootNamespace>Hosihikari.Binding.Bedrock.Interop</RootNamespace>
    <AssemblyName>Hosihikari.Binding.Bedrock.Interop</AssemblyName>
  </PropertyGroup>

  <PropertyGroup>
    <PackageId>Hosihikari.Binding.Bedrock.Interop</PackageId>
    <Version>1.26.60-r0</Version>
    <Authors>Hosihikari</Authors>
    <Description>Generated native-style .NET Interop for the Bedrock Dedicated Server (MCAPI) surface, resolved by symbol name through the LeviLamina preloader.</Description>
    <PackageLicenseExpression>LGPL-3.0-or-later</PackageLicenseExpression>
    <RepositoryUrl>https://github.com/HosihikariProjection/BedrockBinding</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <PackageTags>minecraft;bedrock;bds;mcapi;interop;hosihikari</PackageTags>
    <PackageReadmeFile>README.md</PackageReadmeFile>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="$(AbiProjectPath)" Condition="'$(AbiProjectPath)' != ''" />
    <ProjectReference
      Include="../../../Binding.Abi/src/Hosihikari.Binding.Abi/Hosihikari.Binding.Abi.csproj"
      Condition="'$(AbiProjectPath)' == ''"
    />
  </ItemGroup>

  <ItemGroup>
    <None Include="../../README.md" Pack="true" PackagePath="/" Visible="false" />
  </ItemGroup>
</Project>
